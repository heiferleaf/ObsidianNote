!/.codex/
!/.knowledge-tools/
!/.knowledge/

# Persistent knowledge-base configuration; migration bodies and live snapshots stay local.
/.knowledge/*
!/.knowledge/state.json
!/.knowledge/manifest.json
!/.knowledge/threads.json
!/.knowledge/attachments.json
